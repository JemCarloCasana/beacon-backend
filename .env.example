# Beacon backend - environment placeholders (never commit real secrets).
PORT=3000
MONGODB_URI=mongodb+srv://app_user:password@cluster.example.mongodb.net/beacon?retryWrites=true&w=majority
MONGODB_DB_NAME=beacon
ADMIN_JWT_SECRET=your_secure_admin_jwt_secret
SESSION_SECRET=your_secure_session_secret
ADMIN_FRONTEND_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080
GOOGLE_APPLICATION_CREDENTIALS=C:/secure/beacon/serviceAccountKey.json
# Enable locally only after scripts/checkFirebaseCredentials.mjs succeeds.
# Production always checks revocation and needs valid Firebase Auth read credentials.
FIREBASE_CHECK_REVOKED=true
# Separate credential and empty disposable database, never the application database.
#MONGODB_TEST_URI=mongodb+srv://test_user:password@cluster.example.mongodb.net/?retryWrites=true&w=majority
#MONGODB_TEST_DB_NAME=beacon_test_security_20261009

# Rate limits (requests per window per IP+path; raise for load tests, lower to harden)
#AUTH_RATE_LIMIT_WINDOW_MS=60000
#AUTH_RATE_LIMIT_MAX=15
#ACTION_RATE_LIMIT_WINDOW_MS=60000
#ACTION_RATE_LIMIT_MAX=30
#WRITE_RATE_LIMIT_WINDOW_MS=60000
#WRITE_RATE_LIMIT_MAX=60

# Test-only short-lived admin JWT TTL for browser expiry tests (TP-3).
# Honored ONLY when ALLOW_TEST_JWT_TTL=true AND NODE_ENV is not "production".
# Production always uses the 8h default. Never enable in production.
#ALLOW_TEST_JWT_TTL=true
#ADMIN_JWT_TEST_TTL=30s
